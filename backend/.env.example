PORT=5000
# MongoDB Atlas: replace the placeholders with the database user credentials
# and cluster hostname from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resume-builder?retryWrites=true&w=majority
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
AI_SERVICE_URL=http://localhost:8001
CORS_ORIGIN=http://localhost:3000
